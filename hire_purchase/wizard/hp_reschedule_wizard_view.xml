<?xml version="1.0" encoding="UTF-8"?>
<odoo>
                    <!-- HP Reschedule Wizard -->
                   <record id="view_hp_reschedule_wizard_form" model="ir.ui.view">
                        <field name="name">hp.reschedule.wizard.form</field>
                        <field name="model">hp.reschedule.wizard</field>
                        <field name="type">form</field>
                        <field name="arch" type="xml">
                            <form string="Reschedule Contract">
                                <group>
                                    <field name="contract_id" invisible="1"/>
                                    <field name="new_duration_months"/>
                                    <field name="note"/>
                                </group>
                                <footer>
                                    <button name="action_reschedule" string="Reschedule" type="object" class="btn-primary"/>
                                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                                </footer>
                            </form>
                        </field>
                   </record>

                   <record id="action_hp_reschedule_wizard" model="ir.actions.act_window">
                        <field name="name">Reschedule Contract</field>
                        <field name="res_model">hp.reschedule.wizard</field>
                        <field name="view_mode">form</field>
                        <field name="target">new</field>
                   </record>
