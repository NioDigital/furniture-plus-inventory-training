        <field name="model_id" ref="model_hp_case"/>
        <field name="group_id" ref="group_hp_legal"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ── HP Agreement access (Legal + Auditor) ───────────────────── -->
    <record id="hp_agreement_rule_legal" model="ir.rule">
        <field name="name">HP Agreement: Legal (full)</field>
        <field name="model_id" ref="model_hp_agreement"/>
        <field name="group_id" ref="group_hp_legal"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ── HP Document access (AUD-004, AUD-005) ──────────────────── -->
    <record id="hp_document_rule_credit" model="ir.rule">
        <field name="name">HP Document: Credit (read)</field>
        <field name="model_id" ref="model_hp_document"/>
        <field name="group_id" ref="group_hp_credit_officer"/>
        <field name="domain_force">[('access_group','in',['credit','general'])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hp_document_rule_legal_full" model="ir.rule">
        <field name="name">HP Document: Legal (full)</field>
        <field name="model_id" ref="model_hp_document"/>
        <field name="group_id" ref="group_hp_legal"/>
        <field name="domain_force">[(1,'=',1)]</field>
