        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ── Cashier: read contracts, no write ───────────────────────── -->
    <record id="hp_contract_rule_cashier" model="ir.rule">
        <field name="name">HP Contract: Cashier (read only)</field>
        <field name="model_id" ref="model_hp_contract"/>
        <field name="group_id" ref="group_hp_cashier"/>
        <field name="domain_force">[(1,'=',1)]</field>
