    <!-- ── Auditor: read all (AUD-010) ─────────────────────────────── -->
    <record id="hp_plan_rule_auditor" model="ir.rule">
        <field name="name">HP Plan: Auditor (read only)</field>
        <field name="model_id" ref="model_hp_plan"/>
