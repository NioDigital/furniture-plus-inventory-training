<?xml version="1.0" encoding="UTF-8"?>
<odoo>
              <!-- HP Statement Report (Table 61, SCH-006) -->
             <template id="report_hp_statement">
                 <t t-call="web.basic_layout">
                     <t t-set="doc" t-value="doc"/>
                     <div class="page">
                         <h2>Hire Purchase Statement</h2>
                         <div class="row mt-4">
                             <div class="col"><strong>Contract:</strong> <span t-field="doc.name"/></div>
                             <div class="col"><strong>Customer:</strong> <span t-field="doc.partner_id.name"/></div>
                         </div>
                         <table class="table table-sm mt-4">
                             <thead>
                                 <tr>
                                     <th>#</th>
                                     <th>Due Date</th>
                                     <th class="text-right">Amount</th>
                                     <th class="text-right">Paid</th>
                                     <th class="text-right">Balance</th>
                                     <th>Status</th>
                                 </tr>
                             </thead>
                             <tbody>
                                 <t t-foreach="doc.schedule_line_ids" t-as="line">
                                     <tr>
                                         <td><span t-field="line.instalment_number"/></td>
                                         <td><span t-field="line.due_date"/></td>
                                         <td class="text-right"><span t-esc="line.contractual_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                         <td class="text-right"><span t-esc="line.paid_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                         <td class="text-right"><span t-esc="line.balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                         <td><span t-field="line.status"/></td>
                                     </tr>
                                 </t>
                             </tbody>
                         </table>
                     </div>
                 </t>
             </template>

             <!-- HP Statement Report Action -->
             <record id="action_report_hp_statement" model="ir.actions.report">
                 <field name="name">HP Statement</field>
                 <field name="model">hp.contract</field>
                 <field name="report_type">qweb-pdf</field>
                 <field name="report_name">hire_purchase.report_hp_statement</field>
                 <field name="binding_model_id" ref="model_hp_contract"/>
             </record>
